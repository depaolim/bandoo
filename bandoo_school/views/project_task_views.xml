<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form_bandoo_school" model="ir.ui.view">
        <field name="name">project.task.form.bandoo.school</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Fase nascosta, non tolta dal modello (`D-28`). -->
            <field name="stage_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <!-- Aula: aggiungi dopo il div date_deadline -->
            <div id="date_deadline_and_recurring_task" position="after">
                <field name="room_id" invisible="not project_id"/>
                <field name="x_is_held" invisible="not project_id"/>
            </div>
            <!-- Tab presenze -->
            <notebook position="inside">
                <page name="attendance" string="Presenze" invisible="not project_id">
                    <field name="attendance_line_ids">
                        <list editable="bottom">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="status"
                                   decoration-success="status == 'present'"
                                   decoration-danger="status == 'absent'"
                                   decoration-warning="status == 'absent_justified'"/>
                            <field name="billing_status"/>
                            <field name="note" optional="show"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="view_task_list_bandoo_school" model="ir.ui.view">
        <field name="name">project.task.list.bandoo.school</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_view_tree_base"/>
        <field name="arch" type="xml">
            <!-- Due colonne stage_id, distinte solo dal gruppo: si nascondono
                 per posizione, perche' l'attributo name non le distingue. -->
            <xpath expr="(//field[@name='stage_id'])[1]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="(//field[@name='stage_id'])[2]" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_task_search_bandoo_school" model="ir.ui.view">
        <field name="name">project.task.search.bandoo.school</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="held" string="Rendicontate"
                        domain="[('x_is_held', '=', True)]"/>
                <filter name="not_held" string="Da rendicontare"
                        domain="[('x_is_held', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
