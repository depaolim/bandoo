<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_bandoo_sale" model="ir.ui.view">
        <field name="name">product.template.form.bandoo.sale</field>
        <field name="model">product.template</field>
        <!-- Inherits the sale_project view and not sale's own: the field goes
             next to project_template_id, which sale_project adds. -->
        <field name="inherit_id"
               ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"/>
        <field name="arch" type="xml">
            <!-- Beside the selection that enables it, in "General Information",
                 exactly like project_template_id for the individual case. It
                 used to live in the "Sales" tab, where nobody could guess it
                 was: configuring a collective course meant changing tab.
                 Same markup as Odoo uses for its own conditional fields. -->
            <xpath expr="//field[@name='project_template_id']" position="after">
                <div class="o_td_label d-inline-flex"
                     invisible="service_tracking != 'course_collective'">
                    <label for="x_course_project_id"/>
                </div>
                <field name="x_course_project_id"
                       invisible="service_tracking != 'course_collective'"
                       nolabel="1"/>
                <!-- Durata: vale per entrambi i tipi di corso, quindi non ha
                     la condizione sul tracciamento delle due righe sopra. -->
                <div class="o_td_label d-inline-flex" invisible="not x_is_course">
                    <label for="x_lesson_duration"/>
                </div>
                <field name="x_lesson_duration"
                       invisible="not x_is_course" nolabel="1"/>
                <field name="x_is_course" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
