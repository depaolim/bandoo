<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_bandoo_sale" model="ir.ui.view">
        <field name="name">project.project.form.bandoo.sale</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="bandoo_school.view_project_form_bandoo_school"/>
        <field name="arch" type="xml">
            <field name="x_lesson_target" position="before">
                <field name="sale_line_id" invisible="1"/>
                <field name="x_course_product_id"
                       options="{'no_create': True}"
                       invisible="sale_line_id"/>
            </field>
        </field>
    </record>
</odoo>