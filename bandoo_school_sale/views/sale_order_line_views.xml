<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_line_collective_to_assign" model="ir.ui.view">
        <field name="name">sale.order.line.list.collective.to.assign</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list editable="top" create="false" delete="false">
                <field name="order_id" readonly="1"/>
                <field name="order_partner_id" string="Allievo" readonly="1"/>
                <field name="product_id" string="Corso a catalogo" readonly="1"/>
                <field name="product_template_id" column_invisible="1"/>
                <field name="project_id" string="Corso"
                options="{'no_create': True}"
                domain="[('x_course_product_id', '=', product_template_id)]"/>
            </list>
        </field>
    </record>

    <record id="action_sale_order_line_collective_to_assign" model="ir.actions.act_window">
        <field name="name">Collettivi da assegnare</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_sale_order_line_collective_to_assign"/>
        <field name="domain">[
        ('state', '=', 'sale'),
        ('product_uom_qty', '>', 0),
        ('project_id', '=', False),
        ('product_id.x_lesson_target', '>', 0),
        ('product_id.service_tracking', '=', 'no'),
        ]</field>
    </record>

    <menuitem id="menu_sale_order_line_collective_to_assign"
        parent="sale.sale_order_menu"
        action="action_sale_order_line_collective_to_assign"
        groups="sales_team.group_sale_salesman"
        sequence="25"/>
</odoo>
