<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.bandoo.school.purchase</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='purchase_setting_container']" position="inside">
                <setting id="bandoo_teacher_hour_product" string="Ore insegnante"
                         help="Prodotto proposto dal wizard 'Compenso ore insegnante'.">
                    <field name="teacher_hour_product_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
